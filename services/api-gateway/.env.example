# API Gateway Service Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://hera_user:dev_password_change_me@postgres:5432/hera_dev

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Service URLs
PCOD_SERVICE_URL=http://pcod-service:8001
MOOD_SERVICE_URL=http://mood-service:8002
SAFETY_SERVICE_URL=http://safety-service:8003

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19000

# Environment
ENVIRONMENT=development
