# Hera Platform - Environment Configuration

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hera_dev
DB_USER=hera_user
DB_PASSWORD=dev_password_change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# API Gateway
API_GATEWAY_PORT=8000
API_GATEWAY_DEBUG=true

# Services
PCOD_SERVICE_PORT=8001
MOOD_SERVICE_PORT=8002
SAFETY_SERVICE_PORT=8003

# ML Model Paths
PCOD_MODEL_PATH=/models/pcod_model.pkl
MOOD_MODEL_PATH=/models/mood_model.pkl
SAFETY_MODEL_PATH=/models/safety_model.pkl

# AWS (optional for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
